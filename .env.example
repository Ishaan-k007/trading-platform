FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL — matches docker-compose.yml (host port 5433 -> container 5432)
DATABASE_URL=postgresql://trading_user:trading_pass@localhost:5433/trading_platform

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# C++ risk engine (gRPC)
RISK_ENGINE_HOST=localhost
RISK_ENGINE_PORT=50051

# Kafka — matches docker-compose.yml
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=order-fills

# Write-ahead log — the C++ engine writes wal.log in its working directory;
# run the engine from the repo root so this path resolves to the same file.
WAL_PATH=wal.log

# Strategy runner
STRATEGY_SYMBOLS=BTCUSDT
STRATEGY_DROP_PCT=0.005
STRATEGY_RISE_PCT=0.005
STRATEGY_TRADE_QUANTITY=0.01
STRATEGY_POLL_INTERVAL_SECONDS=2
